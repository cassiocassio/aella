#!/bin/bash
# Minimal AWS CLI stand-in for aella's tests. Never touches AWS.
# Behaviour is driven by FAKE_* env vars; every "service op" is appended to
# $AELLA_TEST_LOG (with " @<region>" on the end) so tests can assert which calls happened, where.
region=""; [ "$1" = --region ] && { region="$2"; shift 2; }
svc="${1:-}"; op="${2:-}"
all="$*"
[ -n "${AELLA_TEST_LOG:-}" ] && echo "$svc $op :: $all @$region" >> "$AELLA_TEST_LOG"
case "$svc $op" in
  "sts get-caller-identity") echo '{"Account":"123456789012"}' ;;
  "ec2 describe-images")
     case "$all" in
       *"Images[].Name"*)
         case "$all" in
           *Fedora*) printf '%s\t%s\t%s\t%s\t%s\n' \
             'Fedora-Cloud-Base-AmazonEC2.x86_64-41-20251215.0' \
             'Fedora-Cloud-Base-AmazonEC2.x86_64-42-20260528.0' \
             'Fedora-Cloud-Base-AmazonEC2.x86_64-ELN-20260827.0' \
             'Fedora-Cloud-Base-AmazonEC2.x86_64-Rawhide-20260827.0' \
             'Fedora-Cloud-Base-AmazonEC2.x86_64-45-Prerelease-20260827.0' ;;
           *) printf '%s\t%s\n' \
             'ubuntu/images/hvm-ssd/ubuntu-noble-24.04-amd64-server-1' \
             'ubuntu/images/hvm-ssd-gp3/ubuntu-plucky-25.04-amd64-server-1' ;;
         esac ;;
       *) echo "${FAKE_AMI:-ami-1234567890}" ;;
     esac ;;
  "ssm get-parameter")
     [ "${FAKE_SSM:-}" = denied ] && { echo "AccessDeniedException: not authorized to perform: ssm:GetParameter" >&2; exit 254; }
     echo "${FAKE_WIN_AMI:-ami-win2025}" ;;
  "ec2 get-password-data")
     [ -n "${FAKE_PW_ERR:-}" ] && { echo "UnauthorizedOperation: cannot decrypt" >&2; exit 254; }
     echo "${FAKE_PW:-}" ;;
  "ec2 describe-key-pairs")
     case "${FAKE_NO_KEYPAIR:-}" in
       notfound) echo "An error occurred (InvalidKeyPair.NotFound)" >&2; exit 254 ;;
       denied)   echo "An error occurred (UnauthorizedOperation)" >&2; exit 254 ;;
     esac ;;
  "ec2 describe-instances")
     case "$all" in
       *tag:Name*)        # per-region rows: FAKE_LS_ROWS_eu_west_2 etc., else FAKE_LS_ROWS everywhere
                          v="FAKE_LS_ROWS_$(printf '%s' "$region" | tr - _)"
                          printf '%s\n' "${!v-${FAKE_LS_ROWS:-}}" ;;
       *PublicIpAddress*) echo "${FAKE_IP:-1.2.3.4}" ;;
       *State.Name*)      echo "${FAKE_STATE:-running}" ;;
       *)                 echo "" ;;
     esac ;;
  "ec2 run-instances")                     echo "${FAKE_IID:-i-newbox000}" ;;
  "ec2 terminate-instances")               echo "i-x	shutting-down" ;;
  "ec2 wait")                              sleep "${FAKE_WAIT_SECS:-0}" ;;
  "ec2 describe-security-groups")
     case "$all" in
       *IpPermissions*) printf '%s\n' "${FAKE_SG_CIDRS:-}" ;;
       *)               echo "sg-123" ;;
     esac ;;
  "ec2 create-security-group")             echo "sg-123" ;;
  "ec2 authorize-security-group-ingress")  : ;;
  "ec2 create-key-pair")                   echo "FAKE-KEY-MATERIAL" ;;
  *) : ;;
esac
